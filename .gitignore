# Reference PDFs and Notes
papers/*.pdf
paper/*.md
# Results
results/figures/*
results/logs/*
!results/figures/.gitkeep
!results/logs/.gitkeep

# Editors
.ipynb_checkpoints/

# vendored third-party agent skills, not part of this project
.agents/

# unpublished thesis material
reports/
